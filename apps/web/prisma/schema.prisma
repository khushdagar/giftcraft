// GiftCraft — Prisma schema
// Stage 1 tables are fully wired; Stage 2–5 tables are present but minimal
// until those sprints land. Decimal(10,2) is used for every money field.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
//   ENUMS
// ═══════════════════════════════════════════════════════════
enum UserRole {
  super_admin
  company_admin
  company_member
  vendor
  reseller
}

enum CompanyTier {
  standard
  silver
  gold
  platinum
}

enum ProductStatus {
  active
  draft
  archived
  seasonal
}

enum PrintingTechnique {
  screen_print
  uv_print
  embroidery
  laser_engraving
  digital_print
  emboss
  none
}

enum OrderStatus {
  draft
  quote_sent
  confirmed
  mockup_pending
  mockup_approved
  payment_pending
  production
  quality_check
  packed
  shipped
  in_transit
  delivered
  completed
  cancelled
  refunded
}

enum QuoteStatus {
  active
  expired
  converted
  cancelled
}

enum DisputeStatus {
  open
  under_review
  resolved
  closed
}

enum VendorPaymentStatus {
  pending
  paid
  overdue
  cancelled
}

enum CommunicationType {
  call
  email
  whatsapp
  meeting
  note
}

enum AutomationTrigger {
  order_placed
  order_confirmed
  order_shipped
  order_delivered
  order_cancelled
  dispute_opened
  quote_created
  quote_expired
  payment_received
  mockup_uploaded
}

enum AutomationAction {
  send_email
  send_whatsapp
  notify_admin
  update_order_status
}

enum ConsentKind {
  marketing_email
  marketing_whatsapp
  analytics
  dpdp_consent
}

enum GocCampaignStatus {
  draft
  active
  paused
  expired
}

enum SampleOrderStatus {
  requested
  approved
  shipped
  rejected
}

// ═══════════════════════════════════════════════════════════
//   NEXTAUTH ADAPTER TABLES (required by @auth/prisma-adapter)
// ═══════════════════════════════════════════════════════════
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════
//   USERS & COMPANIES
// ═══════════════════════════════════════════════════════════
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String? // Set when the user registers with email/password; null for OAuth-only users
  role          UserRole  @default(company_member)
  companyId     String?

  accounts Account[]
  sessions Session[]
  company  Company?  @relation(fields: [companyId], references: [id])

  ordersPlaced      Order[]                 @relation("OrderPlacedBy")
  quotesCreated     Quote[]                 @relation("QuoteCreatedBy")
  disputesSubmitted DisputeTicket[]         @relation("DisputesSubmitted")
  vendorCommLogs    VendorCommunication[]   @relation("VendorCommLogs")
  notificationPref  NotificationPreference?
  consentLogs       ConsentLog[]
  gocCampaigns      GocCampaign[]           @relation("CampaignCreatedBy")
  sampleOrders      SampleOrder[]
  savedAddresses    SavedAddress[]
  blogPosts         BlogPost[]              @relation("BlogPostAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([role])
}

model Company {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  gstin       String?
  pan         String?
  tier        CompanyTier @default(standard)
  addressLine String?
  city        String?
  state       String?
  stateCode   String?
  pincode     String?
  phone       String?
  website     String?
  logoUrl     String?

  users        User[]
  orders       Order[]
  quotes       Quote[]
  brandAssets  BrandAsset[]
  gocCampaigns GocCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model BrandAsset {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  url        String
  mimeType   String
  sizeBytes  Int
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([companyId])
}

// Reusable delivery/shipping addresses saved to a user's account so they can be
// picked in the gift builder / checkout instead of re-typing on every order.
model SavedAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String? // e.g. "Head Office", "Warehouse"
  contactName  String
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════
//   CATALOG — Products, Categories, Occasions, HSN
// ═══════════════════════════════════════════════════════════
model Product {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  brand             String?
  sku               String            @unique
  descriptionShort  String?
  descriptionLong   String?           @db.Text
  // Product-detail tab content (shown on the public product page tabs)
  specifications    String?           @db.Text
  designArtwork     String?           @db.Text
  shippingDelivery  String?           @db.Text
  samplesInfo       String?           @db.Text
  packagingAddons   String?           @db.Text
  material          String?
  dimensionL        Float?
  dimensionW        Float?
  dimensionH        Float?
  weightG           Float?
  moq               Int               @default(25) // Minimum order quantity per product (from product master)
  leadTimeDays      Int               @default(10)
  status            ProductStatus     @default(draft)
  printingTechnique PrintingTechnique @default(none)
  printingPosition  String?
  brandingArea      String? // e.g. "60×40 mm" — printable area
  isEcoCertified    Boolean           @default(false)
  ecoCertification  String? // e.g. "GOTS", "FSC", "GRS", "rPET"
  sampleAvailable   Boolean           @default(false)
  recipientTags     String[]          @default([]) // e.g. "All staff", "Senior, VIP Clients"
  tags              String[]          @default([]) // Free-form tags — drive tag-based occasions/collections (e.g. "budget-friendly", "eco-friendly")
  isFeatured        Boolean           @default(false)
  sortOrder         Int               @default(0)
  metaTitle         String?
  metaDescription   String?

  priceTiers    PriceTier[]
  images        ProductImage[]
  variants      ProductVariant[]
  categories    ProductCategory[]
  occasions     ProductOccasion[]
  hsn           ProductHsn?
  vendors       ProductVendor[]
  orderItems    OrderItem[]
  auditLogs     PriceAuditLog[]
  gocOptions    GocOption[]
  sampleOrders  SampleOrder[]
  giftPackItems GiftPackItem[]

  // ── Curated Pack support ──────────────────────────────────────────────────
  // A pack is a Product (isPack=true) that bundles other products. It gets every
  // normal product field; its price is derived from its member products' tiers,
  // so it carries no own PriceTiers. It shows in /packs, not the /catalog grid.
  isPack           Boolean           @default(false)
  packCollectionId String?
  packCollection   GiftCollection?   @relation("PackCollectionProducts", fields: [packCollectionId], references: [id], onDelete: SetNull)
  packItems        ProductPackItem[] @relation("PackParent")
  inPacks          ProductPackItem[] @relation("PackMember")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@index([isPack])
  @@index([packCollectionId])
}

// A member product inside a pack-product (self-relation on Product), with the
// quantity of that product per pack.
model ProductPackItem {
  id        String  @id @default(cuid())
  packId    String
  pack      Product @relation("PackParent", fields: [packId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("PackMember", fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  sortOrder Int     @default(0)

  @@unique([packId, productId])
  @@index([packId])
  @@index([productId])
}

model PriceTier {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tier      Int // 1..6
  minQty    Int
  maxQty    Int?
  costPrice Decimal @db.Decimal(10, 2)
  sellPrice Decimal @db.Decimal(10, 2)

  @@unique([productId, tier])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String // "color" | "size" | ...
  value     String
  hexColor  String?
  imageUrl  String? // Optional variant image (e.g. product shown in this colour)
  // Optional per-variant price. Used by packaging designs, where each size
  // (Small/Medium/Large) variant carries its own price for the gift builder.
  price     Decimal? @db.Decimal(10, 2)
  sortOrder Int      @default(0)

  @@index([productId])
}

model Category {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  imageUrl  String? // Category cover image (from Unsplash or custom)
  parentId  String?
  parent    Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]         @relation("CategoryTree")
  products  ProductCategory[]
  giftPacks GiftPackCategory[]
  sortOrder Int                @default(0)

  @@index([parentId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductOccasion {
  productId  String
  occasionId String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion   OccasionConfig @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
}

model HsnCode {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String
  defaultGstRate Decimal      @db.Decimal(5, 2)
  products       ProductHsn[]
}

model ProductHsn {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  hsnId     String
  hsn       HsnCode @relation(fields: [hsnId], references: [id])
  gstRate   Decimal @db.Decimal(5, 2)

  @@index([hsnId])
}

// ═══════════════════════════════════════════════════════════
//   PACKAGING & ADD-ONS
// ═══════════════════════════════════════════════════════════
model Packaging {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

model Addon {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

// ═══════════════════════════════════════════════════════════
//   VENDORS
// ═══════════════════════════════════════════════════════════
model Vendor {
  id                  String    @id @default(cuid())
  code                String?   @unique // Vendor code e.g. "V001"
  name                String
  slug                String    @unique
  type                String? // e.g. "Packaging - Boxes", "Brand - Drinkware", "Manufacturer - Apparel"
  productsServices    String?   @db.Text // What the vendor supplies
  contactName         String?
  email               String?
  phone               String?
  whatsapp            String?
  city                String?
  state               String?
  address             String?   @db.Text
  gst                 String?
  paymentTerms        String?
  avgLeadDays         Int? // Average lead time (days)
  minOrderQty         Int? // Minimum order quantity
  qualityRating       Int? // Manual 1-5 rating
  reliabilityRating   Int? // Manual 1-5 rating
  lastUsedAt          DateTime?
  creditDays          Int?
  // Onboarding checklist (from vendor master)
  onboardingStatus    String    @default("pending") // pending | to_approach | onboarding | onboarded
  gstKycReceived      Boolean   @default(false)
  bankDetailsReceived Boolean   @default(false)
  agreementSigned     Boolean   @default(false)
  samplesReceived     Boolean   @default(false)
  onboardedAt         DateTime?
  source              String    @default("admin") // admin | self_registration
  isActive            Boolean   @default(true) // Active vendors are usable for sourcing/POs
  notes               String?   @db.Text
  score               Decimal?  @db.Decimal(5, 2)
  priceConfirmedAt    DateTime?

  products       ProductVendor[]
  payments       VendorPayment[]
  communications VendorCommunication[]
  pos            VendorPO[]            @relation("VendorPos")
  vendorScore    VendorScore?          @relation("VendorScore")
  paymentDetails VendorPaymentDetails? @relation("PaymentDetails")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model ProductVendor {
  id                   String    @id @default(cuid())
  productId            String
  vendorId             String
  product              Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor               Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  costPrice            Decimal?  @db.Decimal(10, 2)
  isPrimary            Boolean   @default(false)
  vendorSku            String? // Vendor's own SKU for this product
  vendorMoq            Int? // Vendor minimum order quantity
  vendorLeadDays       Int? // Vendor lead time in days
  sourcingStatus       String? // e.g. "ok", "to_approach", "onboarding", "onboarded"
  lastPriceConfirmedAt DateTime? // When this vendor's price was last confirmed

  @@unique([productId, vendorId])
}

// ═══════════════════════════════════════════════════════════
//   ORDERS
// ═══════════════════════════════════════════════════════════
model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  placedById  String?
  placedBy    User?    @relation("OrderPlacedBy", fields: [placedById], references: [id])

  status       OrderStatus @default(draft)
  packQuantity Int
  deliveryMode String // single | individual
  deliveryDate DateTime?

  // Addresses (denormalised for historical record)
  billingJson  Json?
  shippingJson Json?

  // Money
  subtotal        Decimal @db.Decimal(10, 2)
  packagingAmount Decimal @default(0) @db.Decimal(10, 2)
  addonsAmount    Decimal @default(0) @db.Decimal(10, 2)
  shippingAmount  Decimal @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal @default(0) @db.Decimal(10, 2)
  cgstAmount      Decimal @default(0) @db.Decimal(10, 2)
  sgstAmount      Decimal @default(0) @db.Decimal(10, 2)
  igstAmount      Decimal @default(0) @db.Decimal(10, 2)
  razorpayFee     Decimal @default(0) @db.Decimal(10, 2)
  grandTotal      Decimal @db.Decimal(10, 2)

  // Branding
  logoUrl       String?
  brandingNotes String? @db.Text
  cardMessage   String? @db.Text

  // Razorpay
  razorpayOrderId   String?
  razorpayPaymentId String?
  paidAt            DateTime?

  // Shiprocket
  shiprocketOrderId String?
  awbCode           String?
  courierName       String?
  trackingUrl       String?

  // GST & Modifications
  gstBillType String? @default("B2C")

  items            OrderItem[]
  addons           OrderAddon[]
  recipients       OrderRecipient[]
  timeline         OrderTimeline[]
  mockups          GeneratedMockup[]
  slaLogs          OrderSlaLog[]
  artworkApprovals ArtworkApproval[]
  disputes         DisputeTicket[]
  einvoice         GstEinvoice?
  modifications    OrderModification[]
  shipmentTracking ShipmentTracking?   @relation("OrderShipments")
  vendorPos        VendorPO[]          @relation("OrderPos")

  revisionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id                String             @id @default(cuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product            @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal            @db.Decimal(10, 2)
  totalPrice        Decimal            @db.Decimal(10, 2)
  hsnCode           String?
  gstRate           Decimal?           @db.Decimal(5, 2)
  printingTechnique PrintingTechnique?

  @@index([orderId])
}

model OrderAddon {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  addonId   String
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int
  total     Decimal @db.Decimal(10, 2)

  @@index([orderId])
}

model OrderRecipient {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name        String
  addressLine String
  city        String
  state       String
  stateCode   String
  pincode     String
  phone       String?

  @@index([orderId])
}

model OrderTimeline {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ═══════════════════════════════════════════════════════════
//   QUOTES & PRICE AUDIT
// ═══════════════════════════════════════════════════════════
model Quote {
  id          String   @id @default(cuid())
  shareToken  String   @unique
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  createdById String?
  createdBy   User?    @relation("QuoteCreatedBy", fields: [createdById], references: [id])

  status    QuoteStatus @default(active)
  payload   Json // snapshot of builder state + pricing
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([shareToken])
}

model PriceAuditLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  tier      Int
  oldCost   Decimal? @db.Decimal(10, 2)
  newCost   Decimal? @db.Decimal(10, 2)
  oldSell   Decimal? @db.Decimal(10, 2)
  newSell   Decimal? @db.Decimal(10, 2)
  changedBy String?
  reason    String?
  createdAt DateTime @default(now())

  @@index([productId])
}

// ═══════════════════════════════════════════════════════════
//   SHIPPING, CONTENT, SETTINGS
// ═══════════════════════════════════════════════════════════
model ShippingZone {
  id     String   @id @default(cuid())
  name   String
  states String[] // list of state codes covered

  // Weight-based rate model (SOW §Shipping Zones: "rate per kg per zone").
  ratePerKg              Decimal  @default(0) @db.Decimal(10, 2) // ₹ per kg of parcel weight
  minCharge              Decimal  @default(0) @db.Decimal(10, 2) // minimum shipping charge per shipment
  freeShippingThreshold  Decimal? @db.Decimal(10, 2) // order subtotal ≥ this ⇒ free (null = never)
  individualSurchargePct Decimal  @default(0) @db.Decimal(5, 2) // extra % for individual delivery

  // Legacy flat rate — kept for back-compat/fallback when ratePerKg is unset.
  flatRate Decimal @db.Decimal(10, 2)

  etaMinDays Int
  etaMaxDays Int
  isActive   Boolean @default(true)
}

model HomepageBanner {
  id        String  @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String?
  ctaLabel  String?
  ctaUrl    String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Testimonial {
  id          String  @id @default(cuid())
  quote       String  @db.Text
  authorName  String
  authorRole  String?
  companyName String?
  avatarUrl   String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
}

model OccasionConfig {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  icon         String?
  gradient     String?
  description  String?
  sortOrder    Int               @default(0)
  isActive     Boolean           @default(true)
  // When true, this entry is a curated "Collection" (homepage Curated Collections
  // section) rather than a "Shop by Occasion" tile. Hidden from occasion tiles/filters.
  isCollection Boolean           @default(false)
  // Products whose `tags` overlap these are auto-included — no manual linking needed.
  tags         String[]          @default([])
  products     ProductOccasion[]
}

// A curated gift pack — a hand-picked set of specific products (with per-item
// quantities) sold as one ready-made assortment. Unlike tag-driven Collections
// (OccasionConfig.isCollection), a pack is an explicit list of SKUs so the
// admin controls exactly what's inside and in what quantity. Customers browse
// packs and load them straight into the builder to customise/brand.
// A Curated Collection groups several curated Packs under one theme
// (e.g. "Weight Loss Starter Kits" containing "Starter Pack", "Pro Pack").
// It is the browse/organise unit; the sellable unit is still the GiftPack.
model GiftCollection {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  image        String?
  gradient     String?
  isActive     Boolean    @default(true)
  isFeatured   Boolean    @default(false)
  sortOrder    Int        @default(0)
  packs        GiftPack[]
  packProducts Product[]  @relation("PackCollectionProducts")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([slug])
  @@index([isActive])
}

model GiftPack {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  descriptionShort String?
  description      String?
  // Optional hero image (DO Spaces URL). When absent, the `gradient` class is
  // used as the tile background (matching the Curated Packs card design).
  image            String?
  gradient         String?
  isActive         Boolean            @default(true)
  isFeatured       Boolean            @default(false)
  sortOrder        Int                @default(0)
  // Optional parent collection. Nullable so legacy/standalone packs still work.
  collectionId     String?
  collection       GiftCollection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  items            GiftPackItem[]
  categories       GiftPackCategory[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([collectionId])
}

model GiftPackItem {
  id        String   @id @default(cuid())
  packId    String
  pack      GiftPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  sortOrder Int      @default(0)

  @@unique([packId, productId])
  @@index([packId])
  @@index([productId])
}

// Join: which categories a curated pack belongs to (mirrors ProductCategory).
// Lets packs be organised/filtered by category like products.
model GiftPackCategory {
  packId     String
  categoryId String
  pack       GiftPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([packId, categoryId])
  @@index([categoryId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  percentOff  Decimal?  @db.Decimal(5, 2)
  flatOff     Decimal?  @db.Decimal(10, 2)
  minOrder    Decimal?  @db.Decimal(10, 2)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  usageLimit  Int?
  usedCount   Int       @default(0)
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════
//   STAGE 2+ SCAFFOLDING — tables present, logic deferred.
//   These are intentionally minimal. Real relations, indexes,
//   and fields get added in the sprint that wires each feature.
// ═══════════════════════════════════════════════════════════

model InventoryStock {
  id        String   @id @default(cuid())
  productId String
  onHand    Int      @default(0)
  updatedAt DateTime @updatedAt
}

model InventoryMovement {
  id        String   @id @default(cuid())
  productId String
  delta     Int
  reason    String
  createdAt DateTime @default(now())
}

model GocCampaign {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  heroImage   String?
  status      GocCampaignStatus @default(draft)
  claimLimit  Int? // null = unlimited
  expiresAt   DateTime?
  companyId   String?
  createdById String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  company   Company?    @relation(fields: [companyId], references: [id])
  createdBy User?       @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  options   GocOption[]
  claims    GocClaim[]

  @@index([companyId])
  @@index([slug])
  @@index([status])
}

model GocOption {
  id         String   @id @default(cuid())
  campaignId String
  productId  String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  campaign GocCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product  Product     @relation(fields: [productId], references: [id])
  claims   GocClaim[]

  @@index([campaignId])
  @@index([productId])
}

model GocClaim {
  id           String    @id @default(cuid())
  campaignId   String
  optionId     String?
  token        String    @unique // nanoid(16) for unique claim URL
  claimerName  String?
  claimerEmail String?
  claimerPhone String?
  addressJson  Json?
  status       String    @default("pending") // pending|submitted|fulfilled
  claimedAt    DateTime?
  createdAt    DateTime  @default(now())

  campaign GocCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  option   GocOption?  @relation(fields: [optionId], references: [id])

  @@index([campaignId])
  @@index([token])
  @@index([status])
}

model CompanyWallet {
  id        String   @id @default(cuid())
  companyId String   @unique
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  delta     Decimal  @db.Decimal(10, 2)
  reason    String
  createdAt DateTime @default(now())
}

model DisputeTicket {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  submittedById   String?
  submittedBy     User?         @relation("DisputesSubmitted", fields: [submittedById], references: [id])
  subject         String
  body            String        @db.Text
  photoUrls       String[]
  status          DisputeStatus @default(open)
  resolutionNote  String?       @db.Text
  resolvedAt      DateTime?
  windowExpiresAt DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
}

model ArtworkApproval {
  id            String    @id @default(cuid())
  orderId       String
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  revision      Int       @default(1)
  fileUrl       String? // CDN URL from Digital Ocean Spaces
  token         String    @unique // nanoid(16) for public approval URL
  status        String    @default("pending") // pending | approved | revision_requested
  revisionNotes String?   @db.Text
  expiresAt     DateTime // 72 hours from creation
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([orderId])
  @@index([token])
}

model OrderSlaLog {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage      String // matches OrderStatus string value
  enteredAt  DateTime  @default(now())
  exitedAt   DateTime?
  slaMinutes Int // expected SLA for this stage in minutes
  isBreached Boolean   @default(false)

  @@index([orderId])
  @@index([isBreached])
}

model AutomationRule {
  id          String            @id @default(cuid())
  name        String
  trigger     AutomationTrigger
  triggerJson Json?
  action      AutomationAction
  actionJson  Json
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([trigger])
  @@index([isActive])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefsJson Json
  updatedAt DateTime @updatedAt
}

// Per-admin "read/dismissed" state for the top-bar notification bell. The bell
// derives alerts live from order/approval/dispute rows (no Notification table),
// so we track which synthetic notification keys (e.g. "order-<id>",
// "revision-<id>", "dispute-<id>") an admin has already seen/cleared.
model AdminNotificationRead {
  id     String   @id @default(cuid())
  userId String
  key    String
  readAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model ConsentLog {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ConsentKind
  granted   Boolean     @default(true)
  ipAddress String?
  grantedAt DateTime    @default(now())

  @@index([userId])
  @@index([kind])
}

model GstEinvoice {
  id        String    @id @default(cuid())
  orderId   String    @unique
  order     Order     @relation(fields: [orderId], references: [id])
  irn       String?
  qrPayload String?   @db.Text
  ackNumber String?
  ackDate   DateTime?
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model OrderModification {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  modifiedBy String?
  diffJson   Json
  reason     String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model SampleOrder {
  id          String            @id @default(cuid())
  productId   String
  userId      String?
  status      SampleOrderStatus @default(requested)
  addressJson Json?
  notes       String?
  adminNotes  String?
  approvedAt  DateTime?
  shippedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([status])
}

model Reseller {
  id             String  @id @default(cuid())
  userId         String  @unique
  commissionRate Decimal @default(10.00) @db.Decimal(5, 2)
}

model ResellerOrder {
  id               String  @id @default(cuid())
  resellerId       String
  orderId          String
  commissionAmount Decimal @db.Decimal(10, 2)
}

model GiftingSequence {
  id        String  @id @default(cuid())
  name      String
  companyId String?
  steps     Json
}

model SequenceEnrollment {
  id             String @id @default(cuid())
  sequenceId     String
  recipientEmail String
  status         String @default("active")
}

model RoiOutcome {
  id          String @id @default(cuid())
  orderId     String
  metricKey   String
  metricValue String
}

model MockupTemplate {
  id     String @id @default(cuid())
  name   String
  config Json
}

model GeneratedMockup {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())

  @@index([orderId])
}

model VendorPayment {
  id            String              @id @default(cuid())
  vendorId      String
  vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invoiceNumber String?
  amount        Decimal             @db.Decimal(10, 2)
  dueDate       DateTime
  paidAt        DateTime?
  status        VendorPaymentStatus @default(pending)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
}

model VendorCommunication {
  id          String            @id @default(cuid())
  vendorId    String
  vendor      Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  type        CommunicationType
  note        String            @db.Text
  createdById String?
  createdBy   User?             @relation("VendorCommLogs", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())

  @@index([vendorId])
}

// ═══════════════════════════════════════════════════════════
//   SHIPROCKET TRACKING
// ═══════════════════════════════════════════════════════════
model ShipmentTracking {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation("OrderShipments", fields: [orderId], references: [id], onDelete: Cascade)

  shiprocketShipmentId Int?
  awbCode              String  @unique
  courierName          String?

  // Status tracking
  status           String   @default("pending") // pending | picked_up | in_transit | out_for_delivery | delivered | exception
  lastStatusUpdate DateTime @updatedAt

  // Location history
  currentLocation   String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?

  // Metadata
  trackingUrl String
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([awbCode])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════
//   VENDOR PO (Purchase Order)
// ═══════════════════════════════════════════════════════════
model VendorPO {
  id       String @id @default(cuid())
  vendorId String
  vendor   Vendor @relation("VendorPos", fields: [vendorId], references: [id], onDelete: Cascade)
  orderId  String
  order    Order  @relation("OrderPos", fields: [orderId], references: [id], onDelete: Cascade)

  // Assignment details
  assignedAt DateTime @default(now())
  assignedBy String?
  deadline   DateTime

  // Status tracking
  status String @default("pending") // pending | in_production | qc_complete | ready_to_ship

  // QC details
  qcPhotos      String[] // Array of CDN URLs
  qcCompletedAt DateTime?
  qcNotes       String?   @db.Text

  // Payment
  ratePerUnit    Decimal   @db.Decimal(10, 2)
  totalAmount    Decimal   @db.Decimal(10, 2)
  paymentDueDate DateTime
  paidAt         DateTime?

  // Communication
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
  @@index([orderId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════
//   VENDOR PERFORMANCE SCORING
// ═══════════════════════════════════════════════════════════
model VendorScore {
  id       String @id @default(cuid())
  vendorId String @unique
  vendor   Vendor @relation("VendorScore", fields: [vendorId], references: [id], onDelete: Cascade)

  qualityScore     Float @default(0) // 0-100
  onTimeScore      Float @default(0) // 0-100
  reliabilityScore Float @default(0) // 0-100

  lastUpdated DateTime @updatedAt

  @@index([vendorId])
}

// ═══════════════════════════════════════════════════════════
//   VENDOR PAYMENT DETAILS
// ═══════════════════════════════════════════════════════════
model VendorPaymentDetails {
  id       String @id @default(cuid())
  vendorId String @unique
  vendor   Vendor @relation("PaymentDetails", fields: [vendorId], references: [id], onDelete: Cascade)

  bankAccountName   String?
  bankAccountNumber String? // Stored encrypted
  bankIfscCode      String?
  bankName          String?

  upiId     String?
  panNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

model WhiteLabelStore {
  id        String @id @default(cuid())
  companyId String @unique
  subdomain String @unique
  themeJson Json
}

// ═══════════════════════════════════════════════════════════
//   PRODUCT ENQUIRIES (Quick Quote leads from product pages)
// ═══════════════════════════════════════════════════════════
enum EnquiryStatus {
  new
  contacted
  quoted
  closed
}

model Enquiry {
  id          String        @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String
  quantity    Int?
  message     String?       @db.Text
  // Denormalised product reference (no FK so deleting a product keeps the lead).
  productId   String?
  productName String?
  status      EnquiryStatus @default(new)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════
//   BLOG — Posts, categories, SEO metadata
// ═══════════════════════════════════════════════════════════

enum BlogPostStatus {
  draft
  published
  archived
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  posts       BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id      String  @id @default(cuid())
  title   String
  slug    String  @unique
  // Short summary used on the listing cards and as the meta-description fallback.
  excerpt String? @db.Text
  // Post body as HTML, produced by the TipTap editor in the admin panel.
  content String  @db.Text

  coverImageUrl String?
  coverImageAlt String?

  status      BlogPostStatus @default(draft)
  // Set the first time a post is published. Also drives the public sort order and
  // lets a post be scheduled by writing a future date.
  publishedAt DateTime?
  isFeatured  Boolean        @default(false)

  // Free-form tags, mirroring how Product tags work.
  tags       String[]      @default([])
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId   String?
  author     User?   @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  // Denormalised so a deleted admin account doesn't blank out the byline.
  authorName String?

  // ── SEO ──────────────────────────────────────────────────
  metaTitle       String?
  metaDescription String? @db.Text
  // Absolute URL; set when this post is a republication of a canonical original.
  canonicalUrl    String?
  ogImageUrl      String?
  // Keep the post out of search indexes without unpublishing it.
  noIndex         Boolean @default(false)

  // Minutes, computed from the content on save.
  readingMinutes Int @default(1)
  viewCount      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([isFeatured])
}
