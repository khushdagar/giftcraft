// GIVOO — Prisma schema
// Stage 1 tables are fully wired; Stage 2–5 tables are present but minimal
// until those sprints land. Decimal(10,2) is used for every money field.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
//   ENUMS
// ═══════════════════════════════════════════════════════════
enum UserRole {
  super_admin
  company_admin
  company_member
  vendor
  reseller
}

enum CompanyTier {
  standard
  silver
  gold
  platinum
}

enum ProductStatus {
  active
  draft
  archived
  seasonal
}

enum CataloguePriceMode {
  starting // lowest tier sell price, shown as "From ₹X"
  base // tier-1 (MOQ) sell price
  hidden
}

enum CatalogueSectionMode {
  category // auto-filled from a Category when the PDF renders
  manual // hand-picked products
}

enum CatalogueTheme {
  warm
  cool
  fresh
  festive
  mono
}

enum PrintingTechnique {
  screen_print
  uv_print
  embroidery
  laser_engraving
  digital_print
  emboss
  none
}

enum OrderStatus {
  draft
  quote_sent
  confirmed
  mockup_pending
  mockup_approved
  payment_pending
  production
  quality_check
  packed
  shipped
  in_transit
  delivered
  completed
  cancelled
  refunded
}

enum QuoteStatus {
  active
  expired
  converted
  cancelled
}

enum DisputeStatus {
  open
  under_review
  resolved
  closed
}

enum VendorPaymentStatus {
  pending
  paid
  overdue
  cancelled
}

enum CommunicationType {
  call
  email
  whatsapp
  meeting
  note
}

enum AutomationTrigger {
  order_placed
  order_confirmed
  order_shipped
  order_delivered
  order_cancelled
  dispute_opened
  quote_created
  quote_expired
  payment_received
  mockup_uploaded
}

enum AutomationAction {
  send_email
  send_whatsapp
  notify_admin
  update_order_status
}

enum ConsentKind {
  marketing_email
  marketing_whatsapp
  analytics
  dpdp_consent
}

enum GocCampaignStatus {
  draft
  active
  paused
  expired
}

enum SampleOrderStatus {
  requested
  approved
  shipped
  rejected
}

// ═══════════════════════════════════════════════════════════
//   NEXTAUTH ADAPTER TABLES (required by @auth/prisma-adapter)
// ═══════════════════════════════════════════════════════════
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════
//   USERS & COMPANIES
// ═══════════════════════════════════════════════════════════
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  passwordHash  String? // Set when the user registers with email/password; null for OAuth-only users
  role          UserRole  @default(company_member)
  companyId     String?

  accounts Account[]
  sessions Session[]
  company  Company?  @relation(fields: [companyId], references: [id])

  ordersPlaced        Order[]                 @relation("OrderPlacedBy")
  quotesCreated       Quote[]                 @relation("QuoteCreatedBy")
  disputesSubmitted   DisputeTicket[]         @relation("DisputesSubmitted")
  vendorCommLogs      VendorCommunication[]   @relation("VendorCommLogs")
  notificationPref    NotificationPreference?
  pushSubscriptions   PushSubscription[]
  consentLogs         ConsentLog[]
  gocCampaigns        GocCampaign[]           @relation("CampaignCreatedBy")
  sampleOrders        SampleOrder[]
  savedAddresses      SavedAddress[]
  savedPacks          SavedPack[]
  blogPosts           BlogPost[]              @relation("BlogPostAuthor")
  reviews             Review[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([role])
}

// Single-use, hashed tokens for the forgot-password flow. The raw token only
// ever lives in the emailed link; the DB stores its SHA-256 hash.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  gstin       String?
  pan         String?
  tier        CompanyTier @default(standard)
  addressLine String?
  city        String?
  state       String?
  stateCode   String?
  pincode     String?
  phone       String?
  website     String?
  logoUrl     String?

  users        User[]
  orders       Order[]
  quotes       Quote[]
  brandAssets  BrandAsset[]
  gocCampaigns GocCampaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model BrandAsset {
  id         String   @id @default(cuid())
  // Optional: a buyer uploads their logo in the builder long before a company
  // exists for them (the company is created from the billing block at checkout).
  // Those uploads are held against `uploadedBy` alone and adopted into the
  // company library the moment one is resolved.
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name       String
  url        String
  mimeType   String
  sizeBytes  Int
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([uploadedBy])
}

// Reusable delivery/shipping addresses saved to a user's account so they can be
// picked in the gift builder / checkout instead of re-typing on every order.
model SavedAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String? // e.g. "Head Office", "Warehouse"
  contactName  String
  company      String?
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  phone        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// A gift-pack configuration a user saved from the builder so it can be
// re-ordered in one click later (Diwali refills, onboarding kits, annual
// events). Stores only what's needed to rebuild the pack in the builder:
// the member products (with chosen variants) and the pack quantity —
// pricing is always re-derived live from current tiers on reorder.
model SavedPack {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String // e.g. "Diwali 2026 — Clients"
  packQuantity Int             @default(25)
  items        SavedPackItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
}

model SavedPackItem {
  id          String    @id @default(cuid())
  savedPackId String
  savedPack   SavedPack @relation(fields: [savedPackId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder   Int       @default(0)
  // Chosen variant picks at save time: [{ kind, value }]. Re-resolved against
  // the product's live variants on reorder, so stale picks degrade gracefully.
  variants    Json?

  @@unique([savedPackId, productId])
  @@index([savedPackId])
  @@index([productId])
}

// ═══════════════════════════════════════════════════════════
//   CATALOG — Products, Categories, Occasions, HSN
// ═══════════════════════════════════════════════════════════
model Product {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  brand             String?
  sku               String            @unique
  descriptionShort  String?
  descriptionLong   String?           @db.Text
  // Rich text (like the other detail tabs). Rendered as its own tab on the
  // product page, and split back into bullet lines for the Proposal Deck PDF —
  // so author it as a bullet list.
  keyFeatures       String?           @db.Text
  // Product-detail tab content (shown on the public product page tabs)
  specifications    String?           @db.Text
  designArtwork     String?           @db.Text
  shippingDelivery  String?           @db.Text
  samplesInfo       String?           @db.Text
  packagingAddons   String?           @db.Text
  material          String?
  dimensionL        Float?
  dimensionW        Float?
  dimensionH        Float?
  weightG           Float?
  moq               Int               @default(25) // Minimum order quantity per product (from product master)
  leadTimeDays      Int               @default(10)
  status            ProductStatus     @default(draft)
  printingTechnique PrintingTechnique @default(none)
  printingPosition  String?
  brandingArea      String? // e.g. "60×40 mm" — printable area
  isEcoCertified    Boolean           @default(false)
  ecoCertification  String? // e.g. "GOTS", "FSC", "GRS", "rPET"
  sampleAvailable   Boolean           @default(false)
  recipientTags     String[]          @default([]) // e.g. "All staff", "Senior, VIP Clients"
  tags              String[]          @default([]) // Free-form tags — drive tag-based occasions/collections (e.g. "budget-friendly", "eco-friendly")
  isFeatured        Boolean           @default(false)
  sortOrder         Int               @default(0)
  // Popularity signal — bumped once per session from the product/pack detail
  // page (POST /api/views). Listings sort by it AFTER `sortOrder`, so manual
  // merchandising still wins and views only break ties.
  viewCount         Int               @default(0)
  metaTitle         String?
  metaDescription   String?

  priceTiers     PriceTier[]
  images         ProductImage[]
  variants       ProductVariant[]
  categories     ProductCategory[]
  occasions      ProductOccasion[]
  hsn            ProductHsn?
  vendors        ProductVendor[]
  orderItems     OrderItem[]
  auditLogs      PriceAuditLog[]
  gocOptions     GocOption[]
  sampleOrders   SampleOrder[]
  giftPackItems  GiftPackItem[]
  reviews        Review[]
  slugHistory    ProductSlugHistory[]
  savedPackItems SavedPackItem[]
  catalogueItems CatalogueItem[]

  // ── Curated Pack support ──────────────────────────────────────────────────
  // A pack is a Product (isPack=true) that bundles other products. It gets every
  // normal product field; its price is derived from its member products' tiers,
  // so it carries no own PriceTiers. It shows in /packs, not the /catalog grid.
  isPack           Boolean           @default(false)
  packCollectionId String?
  packCollection   GiftCollection?   @relation("PackCollectionProducts", fields: [packCollectionId], references: [id], onDelete: SetNull)
  packItems        ProductPackItem[] @relation("PackParent")
  inPacks          ProductPackItem[] @relation("PackMember")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@index([isPack])
  @@index([packCollectionId])
  @@index([viewCount])
}

// Every slug a product has ever had. Written whenever an admin changes a
// product's slug, so /products/<old-slug> can 301 to the current one instead of
// 404ing — old links, search results and shared URLs keep working.
model ProductSlugHistory {
  id        String   @id @default(cuid())
  // The RETIRED slug. Unique so one old URL can never point at two products.
  slug      String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

// A member product inside a pack-product (self-relation on Product), with the
// quantity of that product per pack.
model ProductPackItem {
  id        String  @id @default(cuid())
  packId    String
  pack      Product @relation("PackParent", fields: [packId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("PackMember", fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)
  sortOrder Int     @default(0)

  @@unique([packId, productId])
  @@index([packId])
  @@index([productId])
}

model PriceTier {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tier      Int // 1..6
  minQty    Int
  maxQty    Int?
  costPrice Decimal @db.Decimal(10, 2)
  sellPrice Decimal @db.Decimal(10, 2)

  @@unique([productId, tier])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      String // "color" | "size" | ...
  value     String
  hexColor  String?
  imageUrl  String? // Optional variant image (e.g. product shown in this colour)
  // Optional per-variant price. Used by packaging designs, where each size
  // (Small/Medium/Large) variant carries its own price for the gift builder.
  price     Decimal? @db.Decimal(10, 2)
  sortOrder Int      @default(0)

  @@index([productId])
}

model Category {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  description  String?            @db.Text // Shopify-style collection description — rich text, renders ABOVE the product grid
  contentBelow String?            @db.Text // Rich text rendered BELOW the product grid (SEO/editorial copy)
  // Ordered [{ question, answer }] pairs — the /category/[slug] FAQ section
  // and FAQPage JSON-LD, same pattern as OccasionConfig.faqs.
  faqs         Json?
  // SEO overrides for /category/[slug]. Fall back to a generated
  // title/description when unset.
  metaTitle       String?
  metaDescription String?         @db.Text
  imageUrl     String? // Category cover image (from Unsplash or custom)
  parentId     String?
  parent       Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]         @relation("CategoryTree")
  products     ProductCategory[]
  giftPacks    GiftPackCategory[]
  catalogueSections CatalogueSection[]
  sortOrder    Int                @default(0)

  @@index([parentId])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductOccasion {
  productId  String
  occasionId String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion   OccasionConfig @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
}

// ═══════════════════════════════════════════════════════════
//   CATALOGUES — admin-built PDF product catalogues
// ═══════════════════════════════════════════════════════════
// A Catalogue is a printable A4 PDF ("August New Launches", "Diwali 2026
// Range") made of ordered sections. A section is either a live Category
// (products pulled at render time, so the PDF is never stale) or a hand-picked
// list. Rendered by /api/catalogues/[shareToken]/pdf.
model Catalogue {
  id              String             @id @default(cuid())
  title           String
  slug            String             @unique
  coverImageUrl   String?
  closingNote     String?            @db.Text
  // Full-bleed photo behind the closing "Thank you" page. Null = the first
  // active homepage hero banner.
  closingImageUrl String?
  theme           CatalogueTheme     @default(warm)
  priceMode       CataloguePriceMode @default(starting)
  showSku         Boolean            @default(false)
  showMoq         Boolean            @default(true)
  sections        CatalogueSection[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model CatalogueSection {
  id              String               @id @default(cuid())
  catalogueId     String
  catalogue       Catalogue            @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  title           String
  mode            CatalogueSectionMode @default(manual)
  categoryId      String?
  category        Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  includeChildren Boolean              @default(true)
  // Cap for category sections (null = every active product in it).
  maxProducts     Int?
  sortOrder       Int                  @default(0)
  items           CatalogueItem[]

  @@index([catalogueId])
  @@index([categoryId])
}

model CatalogueItem {
  id        String           @id @default(cuid())
  sectionId String
  section   CatalogueSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Optional pill drawn on the card, e.g. "New", "Bestseller".
  badge     String?
  sortOrder Int              @default(0)

  @@unique([sectionId, productId])
  @@index([productId])
}

model HsnCode {
  id             String       @id @default(cuid())
  code           String       @unique
  description    String
  defaultGstRate Decimal      @db.Decimal(5, 2)
  products       ProductHsn[]
}

model ProductHsn {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  hsnId     String
  hsn       HsnCode @relation(fields: [hsnId], references: [id])
  gstRate   Decimal @db.Decimal(5, 2)

  @@index([hsnId])
}

// ═══════════════════════════════════════════════════════════
//   PACKAGING & ADD-ONS
// ═══════════════════════════════════════════════════════════
model Packaging {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

model Addon {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  price       Decimal @db.Decimal(10, 2)
  imageUrl    String?
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

// ═══════════════════════════════════════════════════════════
//   VENDORS
// ═══════════════════════════════════════════════════════════
model Vendor {
  id                  String    @id @default(cuid())
  code                String?   @unique // Vendor code e.g. "V001"
  name                String
  slug                String    @unique
  type                String? // e.g. "Packaging - Boxes", "Brand - Drinkware", "Manufacturer - Apparel"
  productsServices    String?   @db.Text // What the vendor supplies
  contactName         String?
  email               String?
  phone               String?
  whatsapp            String?
  city                String?
  state               String?
  address             String?   @db.Text
  gst                 String?
  paymentTerms        String?
  avgLeadDays         Int? // Average lead time (days)
  minOrderQty         Int? // Minimum order quantity
  qualityRating       Int? // Manual 1-5 rating
  reliabilityRating   Int? // Manual 1-5 rating
  lastUsedAt          DateTime?
  creditDays          Int?
  // Onboarding checklist (from vendor master)
  onboardingStatus    String    @default("pending") // pending | to_approach | onboarding | onboarded
  gstKycReceived      Boolean   @default(false)
  bankDetailsReceived Boolean   @default(false)
  agreementSigned     Boolean   @default(false)
  samplesReceived     Boolean   @default(false)
  onboardedAt         DateTime?
  source              String    @default("admin") // admin | self_registration
  isActive            Boolean   @default(true) // Active vendors are usable for sourcing/POs
  notes               String?   @db.Text
  score               Decimal?  @db.Decimal(5, 2)
  priceConfirmedAt    DateTime?

  products       ProductVendor[]
  payments       VendorPayment[]
  communications VendorCommunication[]
  pos            VendorPO[]            @relation("VendorPos")
  vendorScore    VendorScore?          @relation("VendorScore")
  paymentDetails VendorPaymentDetails? @relation("PaymentDetails")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model ProductVendor {
  id                   String    @id @default(cuid())
  productId            String
  vendorId             String
  product              Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor               Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  costPrice            Decimal?  @db.Decimal(10, 2)
  isPrimary            Boolean   @default(false)
  vendorSku            String? // Vendor's own SKU for this product
  vendorMoq            Int? // Vendor minimum order quantity
  vendorLeadDays       Int? // Vendor lead time in days
  sourcingStatus       String? // e.g. "ok", "to_approach", "onboarding", "onboarded"
  lastPriceConfirmedAt DateTime? // When this vendor's price was last confirmed

  @@unique([productId, vendorId])
}

// ═══════════════════════════════════════════════════════════
//   ORDERS
// ═══════════════════════════════════════════════════════════
model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  placedById  String?
  placedBy    User?    @relation("OrderPlacedBy", fields: [placedById], references: [id])

  status       OrderStatus @default(draft)
  packQuantity Int
  deliveryMode String // single | individual
  deliveryDate DateTime?

  // Addresses (denormalised for historical record)
  billingJson  Json?
  shippingJson Json?

  // Money
  subtotal        Decimal @db.Decimal(10, 2)
  packagingAmount Decimal @default(0) @db.Decimal(10, 2)
  addonsAmount    Decimal @default(0) @db.Decimal(10, 2)
  shippingAmount  Decimal @default(0) @db.Decimal(10, 2)
  discountAmount  Decimal @default(0) @db.Decimal(10, 2)
  cgstAmount      Decimal @default(0) @db.Decimal(10, 2)
  sgstAmount      Decimal @default(0) @db.Decimal(10, 2)
  igstAmount      Decimal @default(0) @db.Decimal(10, 2)
  razorpayFee     Decimal @default(0) @db.Decimal(10, 2)
  grandTotal      Decimal @db.Decimal(10, 2)

  // Branding
  logoUrl       String?
  brandingNotes String? @db.Text
  cardMessage   String? @db.Text

  // Razorpay
  razorpayOrderId   String?
  razorpayPaymentId String?
  paidAt            DateTime?

  // Shiprocket
  shiprocketOrderId String?
  awbCode           String?
  courierName       String?
  trackingUrl       String?

  // GST & Modifications
  gstBillType String? @default("B2C")

  items            OrderItem[]
  addons           OrderAddon[]
  recipients       OrderRecipient[]
  timeline         OrderTimeline[]
  mockups          GeneratedMockup[]
  slaLogs          OrderSlaLog[]
  artworkApprovals ArtworkApproval[]
  disputes         DisputeTicket[]
  einvoice         GstEinvoice?
  modifications    OrderModification[]
  shipmentTracking ShipmentTracking?   @relation("OrderShipments")
  vendorPos        VendorPO[]          @relation("OrderPos")

  revisionCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([orderNumber])
}

model OrderItem {
  id                String             @id @default(cuid())
  orderId           String
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId         String
  product           Product            @relation(fields: [productId], references: [id])
  quantity          Int
  unitPrice         Decimal            @db.Decimal(10, 2)
  totalPrice        Decimal            @db.Decimal(10, 2)
  hsnCode           String?
  gstRate           Decimal?           @db.Decimal(5, 2)
  printingTechnique PrintingTechnique?
  // Snapshot of the variants the customer picked (colour AND size, etc.) as
  // [{ kind, value, hex }]. Stored as values, not ProductVariant FKs, so an
  // order keeps showing what was actually ordered even if a variant is later
  // renamed or deleted. An array because one product can have several kinds.
  variantsJson      Json?

  @@index([orderId])
}

