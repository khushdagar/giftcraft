model OccasionConfig {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  icon         String?
  // Optional hero image for the occasion tile (Digital Ocean Spaces CDN URL).
  // When set, the customer UI shows this photo instead of the flat gradient.
  imageUrl     String?
  gradient     String?
  // Rich text, rendered ABOVE the product grid on /occasion/[slug].
  description  String?           @db.Text
  // Rich text, rendered BELOW the product grid (SEO/editorial copy).
  contentBelow String?           @db.Text
  // SEO overrides for /occasion/[slug]. Fall back to occasionCopy()'s
  // generated title/description when unset.
  metaTitle    String?
  metaDescription String?        @db.Text
  // Ordered [{ question, answer }] pairs — the /occasion/[slug] FAQ section
  // and FAQPage JSON-LD.
  faqs         Json?

  // The same taxonomy also organises curated packs (isPack:true products), on
  // a DIFFERENT page — /curated-packs/occasions/[slug]. Sharing one occasion
  // across both surfaces (rather than a second occasion list) means tagging a
  // pack to "Diwali" needs no separate pack-only taxonomy to keep in sync, but
  // the two pages would otherwise render identical copy — thin/duplicate
  // content for search engines. These `pack*` fields give the pack page its
  // own independent title, intro, body copy and FAQs.
  // Optional H1/tile-label override — blank means "use `name`". Everything
  // ELSE about the occasion (slug, tags, membership) stays shared.
  packName           String?
  packDescription    String?     @db.Text
  packContentBelow   String?     @db.Text
  packMetaTitle      String?
  packMetaDescription String?    @db.Text
  packFaqs           Json?

  sortOrder    Int               @default(0)
  // Popularity signal for occasion/collection tiles — bumped once per session
  // from /occasion/[slug]. Sorts after `sortOrder`, same as Product.viewCount.
  viewCount    Int               @default(0)
  isActive     Boolean           @default(true)
  // When true, this entry is a curated "Collection" (homepage Curated Collections
  // section) rather than a "Shop by Occasion" tile. Hidden from occasion tiles/filters.
  isCollection Boolean           @default(false)
  // Products whose `tags` overlap these are auto-included — no manual linking needed.
  tags         String[]          @default([])
  products     ProductOccasion[]
}

// A curated gift pack — a hand-picked set of specific products (with per-item
// quantities) sold as one ready-made assortment. Unlike tag-driven Collections
// (OccasionConfig.isCollection), a pack is an explicit list of SKUs so the
// admin controls exactly what's inside and in what quantity. Customers browse
// packs and load them straight into the builder to customise/brand.
// A Curated Collection groups several curated Packs under one theme
// (e.g. "Weight Loss Starter Kits" containing "Starter Pack", "Pro Pack").
// It is the browse/organise unit; the sellable unit is still the GiftPack.
model GiftCollection {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String?
  image        String?
  gradient     String?
  isActive     Boolean          @default(true)
  isFeatured   Boolean          @default(false)
  sortOrder    Int              @default(0)
  // Self-referencing tree, capped at TWO levels by the API: a top-level
  // collection (parentId = null) holds sub-collections, and a sub-collection
  // holds the packs. A collection with no children still holds its packs
  // directly, so every pre-existing collection keeps working untouched.
  parentId     String?
  // SetNull, not Cascade: deleting a parent promotes its sub-collections to
  // top-level rather than destroying them and orphaning their packs — the same
  // forgiving rule the packs themselves already follow.
  parent       GiftCollection?  @relation("CollectionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     GiftCollection[] @relation("CollectionTree")
  packs        GiftPack[]
  packProducts Product[]        @relation("PackCollectionProducts")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([parentId])
}

model GiftPack {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  descriptionShort String?
  description      String?
  // Optional hero image (DO Spaces URL). When absent, the `gradient` class is
  // used as the tile background (matching the Curated Packs card design).
  image            String?
  gradient         String?
  isActive         Boolean            @default(true)
  isFeatured       Boolean            @default(false)
  sortOrder        Int                @default(0)
  // Optional parent collection. Nullable so legacy/standalone packs still work.
  collectionId     String?
  collection       GiftCollection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  items            GiftPackItem[]
  categories       GiftPackCategory[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([slug])
  @@index([isActive])
  @@index([collectionId])
}

model GiftPackItem {
  id        String   @id @default(cuid())
  packId    String
  pack      GiftPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  sortOrder Int      @default(0)

  @@unique([packId, productId])
  @@index([packId])
  @@index([productId])
}

// Join: which categories a curated pack belongs to (mirrors ProductCategory).
// Lets packs be organised/filtered by category like products.
model GiftPackCategory {
  packId     String
  categoryId String
  pack       GiftPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([packId, categoryId])
  @@index([categoryId])
}

