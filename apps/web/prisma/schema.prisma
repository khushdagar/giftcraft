  minCharge              Decimal  @default(0) @db.Decimal(10, 2) // minimum shipping charge per shipment
  freeShippingThreshold  Decimal? @db.Decimal(10, 2) // order subtotal ≥ this ⇒ free (null = never)
  individualSurchargePct Decimal  @default(0) @db.Decimal(5, 2) // extra % for individual delivery

  // Legacy flat rate — kept for back-compat/fallback when ratePerKg is unset.
  flatRate Decimal @db.Decimal(10, 2)

  etaMinDays Int
  etaMaxDays Int
  isActive   Boolean @default(true)
}

