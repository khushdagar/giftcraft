  vendor   Vendor @relation("PaymentDetails", fields: [vendorId], references: [id], onDelete: Cascade)

  bankAccountName   String?
  bankAccountNumber String? // Stored encrypted
  bankIfscCode      String?
  bankName          String?

  upiId     String?
  panNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vendorId])
}

model WhiteLabelStore {
  id        String @id @default(cuid())
  companyId String @unique
  subdomain String @unique
  themeJson Json
}

// ═══════════════════════════════════════════════════════════
//   PRODUCT ENQUIRIES (Quick Quote leads from product pages)
// ═══════════════════════════════════════════════════════════
enum EnquiryStatus {
  new
  contacted
  quoted // shown as "Proposal sent"
  pending
  closed
}

// Pipeline status for a GoHighLevel lead. GHL stays the source of truth for the
// lead itself (nothing is copied here); this only records how far WE have taken
// it. Keyed by the synthetic lead id from lib/ghl.ts — "sub-<submissionId>" for
// a form submission, "contact-<contactId>" for a CRM-only contact.
model GhlLeadStatus {
  id     String        @id @default(cuid())
  leadId String        @unique
  status EnquiryStatus @default(new)
  // Dismissed from the admin Enquiries table. GHL stays the source of truth —
  // the contact is untouched there — this only hides the row on our side, so it
  // can always be brought back with the "Show hidden" toggle.
  hidden Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id          String        @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String
  quantity    Int?
  message     String?       @db.Text
  // Denormalised product reference (no FK so deleting a product keeps the lead).
  productId   String?
  productName String?
  status      EnquiryStatus @default(new)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

// A "notify me when back in stock" submission from a pack page — captured
// against the specific out-of-stock member product, not the pack itself, so
// the same request still makes sense if the product later leaves the pack.
model RestockRequest {
  id          String   @id @default(cuid())
  productId   String
  productName String
  email       String
  phone       String?
  notified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([notified])
}

// ═══════════════════════════════════════════════════════════
//   BLOG — Posts, categories, SEO metadata
// ═══════════════════════════════════════════════════════════

enum BlogPostStatus {
  draft
  published
  archived
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  posts       BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id      String  @id @default(cuid())
  title   String
  slug    String  @unique
  // Short summary used on the listing cards and as the meta-description fallback.
  excerpt String? @db.Text
  // Post body as HTML, produced by the TipTap editor in the admin panel.
  content String  @db.Text

  coverImageUrl String?
  coverImageAlt String?

  status      BlogPostStatus @default(draft)
  // Set the first time a post is published. Also drives the public sort order and
  // lets a post be scheduled by writing a future date.
  publishedAt DateTime?
  isFeatured  Boolean        @default(false)

  // Free-form tags, mirroring how Product tags work.
  tags       String[]      @default([])
  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  authorId   String?
  author     User?   @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  // Denormalised so a deleted admin account doesn't blank out the byline.
  authorName String?

  // ── SEO ──────────────────────────────────────────────────
  metaTitle       String?
  metaDescription String? @db.Text
  // Absolute URL; set when this post is a republication of a canonical original.
  canonicalUrl    String?
  ogImageUrl      String?
  // Keep the post out of search indexes without unpublishing it.
  noIndex         Boolean @default(false)

  // Minutes, computed from the content on save.
  readingMinutes Int @default(1)
  viewCount      Int @default(0)

  comments BlogComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([isFeatured])
}

/// A blog author entity — rendered on /blog/author/[slug] with Person schema.
/// Posts reference it by name (denormalised, same as BlogPost.authorName), so
/// renaming an author also rewrites the posts that carry the old byline.
/// The oldest row is the default byline for posts without one.
model BlogAuthor {
  id      String @id @default(cuid())
  name    String @unique
  slug    String @unique
  role    String
  /// One-liner used for meta description and Person.description.
  summary String @default("") @db.Text
  /// Bio paragraphs, rendered in order.
  bio         String[] @default([])
  credentials String[] @default([])
  /// Topics for Person.knowsAbout.
  knowsAbout String[] @default([])
  /// Real public profile URLs (LinkedIn etc.) — never placeholders.
  sameAs String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

enum BlogCommentStatus {
  pending
  approved
  rejected
}

/// Reader comments on a blog post. Open to anyone, so nothing is public until a
/// super_admin approves it from the moderation queue.
model BlogComment {
  id     String   @id @default(cuid())
  postId String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorName String
  // Never rendered publicly — kept only so we can reply to or block a commenter.
  email      String
  body       String @db.Text

  status     BlogCommentStatus @default(pending)
  // Set when a super_admin approves; drives the public sort order.
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, status])
  @@index([status, createdAt])
}

// ═══════════════════════════════════════════════════════════
//   REVIEWS — Product ratings & reviews
// ═══════════════════════════════════════════════════════════
enum ReviewStatus {
  pending
  approved
  rejected
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating  Int // 1–5 stars
  title   String?
  comment String  @db.Text

  // Only approved reviews are shown publicly; edits send a review back to pending.
  status          ReviewStatus @default(pending)
  // Set at submit time when the user has a paid order containing this product.
  isVerifiedBuyer Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per user per product (users edit their existing review instead).
  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status])
}

// A price rung on /curated-packs/budget. Admin-managed like OccasionConfig, so
// bands can be renamed, re-imaged and re-priced without a deploy.
//
// Membership is NOT stored: a pack belongs to the band its computed "from"
// price falls into, so a price change moves it automatically and there is
// nothing to keep in sync.
model BudgetBand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  // Hero image for the tile (Digital Ocean Spaces CDN URL). Falls back to
  // `gradient`, then to the grid's own rotation, so a bare band still looks
  // deliberate.
  imageUrl    String?
  gradient    String?
  // Inclusive floor, exclusive ceiling — ₹500 sits in "₹500 – ₹1,000" and never
  // in two bands at once. A null ceiling means "and above".
  minPrice    Int
  maxPrice    Int?
  // SEO overrides for /curated-packs/budget/[slug]. Fall back to a generated
  // title/description built from `name`/`description` when unset.
  metaTitle       String?
  metaDescription String? @db.Text
  // Rich text, rendered BELOW the pack grid (SEO/editorial copy) — same slot
  // as OccasionConfig.contentBelow.
  contentBelow    String? @db.Text
  // Ordered [{ question, answer }] pairs rendered as an FAQ section below the
  // page and emitted as FAQPage JSON-LD. No dedicated table since a band's
  // FAQs are never queried/reused outside their own page.
  faqs            Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

// ═══════════════════════════════════════════════════════════
//   ADMIN ACTIVITY LOG
// ═══════════════════════════════════════════════════════════
// Every write made through an /api/admin/* request by a signed-in admin is
// recorded here automatically by the Prisma extension in lib/audit.ts — routes
// don't have to opt in, so new admin endpoints are covered the day they ship.
model AdminActivityLog {
  id          String   @id @default(cuid())
  // Who — denormalised on purpose: the log must stay readable even if the user
  // record is later renamed or deleted.
  actorId     String?
  actorName   String?
  actorEmail  String?
  actorRole   String?
  // What
  action      String // create | update | delete | createMany | updateMany | deleteMany | upsert
  entity      String // Prisma model name, e.g. "Product"
  entityId    String?
  entityLabel String? // human name of the record at write time (name/title/slug/email)
  // Field-level diff: { field: { from, to } } for updates, the submitted data
  // for creates, the removed record's summary for deletes.
  changes     Json?
  // Where
  path        String?
  method      String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorEmail, createdAt])
  @@index([entity, entityId])
}

// ═══════════════════════════════════════════════════════════
//   URL REDIRECTS
// ═══════════════════════════════════════════════════════════
// SEO-managed redirects for URLs that used to exist and are still indexed by
// Google. Kept in the database rather than next.config.js so the SEO team can
// add them from /admin/redirects without a code change or a deploy.
//
// `source` is stored normalised (lowercase, leading slash, no trailing slash,
// no query string) — middleware normalises the incoming path the same way, so
// a lookup is a plain map hit. A trailing "/*" makes it a prefix rule.
// ═══════════════════════════════════════════════════════════
//   PAGE SEO OVERRIDES
// ═══════════════════════════════════════════════════════════
// Per-page SEO meta managed from /admin/seo, so the SEO team can tune tags
// without a deploy. `path` is stored normalised exactly like UrlRedirect.source
// (lowercase, leading slash, no trailing slash, no query string).
//
// Every field is an OVERRIDE: when null, the page keeps whatever metadata its
// code already generates — so a page with no PageSeo row behaves exactly as
// before this table existed.
model PageSeo {
  id              String  @id @default(cuid())
  path            String  @unique
  metaTitle       String?
  metaDescription String? @db.Text
  // Absolute URL for <link rel="canonical">.
  canonicalUrl    String?
  ogTitle         String?
  ogDescription   String? @db.Text
  ogImageUrl      String?
  // Tri-state on purpose: null inherits the page's own robots logic (e.g. an
  // occasion page noindexes itself when it has zero products) — only an
  // explicit true/false from the admin overrides it.
  noIndex         Boolean?
  noFollow        Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UrlRedirect {
  id          String   @id @default(cuid())
  source      String   @unique
  // Empty for status 410 ("gone" — the page is deliberately dead). Otherwise a
  // site path ("/catalog") or an absolute URL to another domain.
  destination String
  // 301 permanent | 302 temporary | 410 gone. Permanent is the default because
  // that is what passes ranking signals on to the new URL.
  statusCode  Int      @default(301)
  isActive    Boolean  @default(true)
  // Free-text: which GSC report the URL came from, who asked for it, etc.
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}
